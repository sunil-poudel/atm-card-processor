# =============================================================================
# ATM Card Processor - Environment Configuration Example
# Development & local evaluation only. NEVER use these example secrets in production!
# Generate production secrets using: ./scripts/gen-secrets.sh
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=minicard
POSTGRES_USER=minicard
POSTGRES_PASSWORD=development_postgres_password_only_change_me!
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/minicard
SPRING_DATASOURCE_USERNAME=minicard
SPRING_DATASOURCE_PASSWORD=development_postgres_password_only_change_me!

# Security & Authentication (JWT Secret must be >= 32 bytes base64)
APP_SECURITY_JWT_SECRET=dGhpc0lzQURldmVsb3BtZW50SldUU2VjcmV0S2V5Rm9yTWluaUNhcmRQcm9jZXNzb3IyMDI2VGVzdGluZw==
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:4200,http://127.0.0.1:4200

# Card PAN Encryption (AES-256-GCM Key & HMAC Blind Indexing Key)
APP_CRYPTO_PAN_CURRENT_KEY_ID=k1
APP_CRYPTO_PAN_KEYS_K1=ZGV2ZWxvcG1lbnRBZXMyNTZLZXlGb3JNaW5pQ2FyZCE=
APP_CRYPTO_PAN_HASH_KEY=ZGV2ZWxvcG1lbnRIbWFjU2hhMjU2S2V5TWluaUNhcmQ=

# Bootstrap Administrator
APP_BOOTSTRAP_ADMIN_EMAIL=admin@minicard.local
APP_BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!

# Business & Operational Settings
APP_CARDS_BIN=990000
APP_CARDS_EXPOSE_PAN_ON_ISSUE=true
APP_BUSINESS_ZONE=Asia/Kathmandu
APP_FRAUD_FLAG_THRESHOLD=50
APP_FRAUD_DECLINE_THRESHOLD=80
APP_DISPUTES_EVIDENCE_DAYS=7
APP_DISPUTES_MAX_AGE_DAYS=120
APP_DISPUTES_DEADLINE_JOB_CRON=0 0 * * * *

# Spring Profiles & Demo Data
SPRING_PROFILES_ACTIVE=prod,demo
DEMO_DATA=true
SPRINGDOC_ENABLED=false
